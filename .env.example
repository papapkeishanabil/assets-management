# ============================================================
# Supabase configuration
# Get these from: Supabase Dashboard > Project Settings > API
# ============================================================
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Peta gratis memakai Leaflet + tile OpenStreetMap; tanpa API key/billing.
# Opsional: ganti penyedia tile HTTPS {z}/{x}/{y} sesuai lisensi/policy penyedia.
# Atribusi OpenStreetMap tetap ada; kredit tambahan diperlakukan sebagai teks.
VITE_VENDOR_MAP_TILE_URL=
VITE_VENDOR_MAP_TILE_CREDIT=
