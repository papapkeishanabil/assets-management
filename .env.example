# ============================================================
# Supabase configuration
# Get these from: Supabase Dashboard > Project Settings > API
# ============================================================

# --- Frontend (PUBLIC) — injected by Vite via VITE_ prefix ---
VITE_SUPABASE_URL=https://<your-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# --- Local tooling only (GITIGNORED) ---
# Copy this section to .env.local (NOT committed, NOT a secret leak).
# SERVICE ROLE key — read ONLY by Node scripts (test/migration tooling).
# NEVER prefix with VITE_ (would expose to browser). NEVER commit .env.local.
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# --- Web Push / Notifikasi (PUBLIC) — agar notifikasi muncul walau app ditutup ---
# Generate VAPID keys:  npx web-push generate-vapid-keys
#   Public key  → VITE_VAPID_PUBLIC_KEY (Vercel env) + VAPID_PUBLIC_KEY (Supabase env)
#   Private key → HANYA di Supabase env (VAPID_PRIVATE_KEY) — JANGAN di frontend.
# Tanpa key ini, push subscription & notifikasi background tidak berfungsi.
VITE_VAPID_PUBLIC_KEY=
